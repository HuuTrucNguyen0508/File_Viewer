<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing to back up: recents are local paths and URI grants that don't survive a device move. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
